{
  "name": "nutrition-tracker-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:frontend": "cross-env-shell \"cd NutriScan && npx expo start -c\"",
    "start:backend": "cross-env-shell \"cd backend && npm run dev\"",
    "start": "concurrently -n FRONTEND,BACKEND -c cyan,green \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-picker/picker": "^2.11.4",
    "axios": "^1.13.4",
    "chart.js": "^4.5.1",
    "expo": "^54.0.30",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0"
  }
}
